<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Health on the watch: the workout session that keeps a recording going with the wrist
	     down. Only the TestFlight build is signed with it (see .github/workflows/testflight.yml). -->
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
